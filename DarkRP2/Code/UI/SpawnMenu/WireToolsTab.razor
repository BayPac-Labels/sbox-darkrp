@using Sandbox;
@using Sandbox.UI;
@inherits Panel
@namespace Sandbox
@implements IUtilityTab
@attribute [Icon( "⚡" )]
@attribute [Title( "#spawnmenu.tab.wire" )]
@attribute [Order( -50 )]

<root class="tab">
	<div class="left">
		<VerticalMenu Value="@(CurrentMode?.GetType())" class="menuinner">
			<Options>
				@foreach ( var type in GetWireTools() )
				{
					<MenuOption Text="@Game.Language.GetPhrase( type.Title.TrimStart( '#' ) )" Icon="@type.Icon" @onclick="@(() => SwitchMode( type ))" Value="@type.TargetType"></MenuOption>
				}
			</Options>
		</VerticalMenu>
	</div>

	<div class="body menuinner">
		<ControlSheet PropertyFilter="@FilterProperties" Target="@GetCurrentMode()"></ControlSheet>

		@if ( CurrentMode is WireGateTool gateTool )
		{
			<div class="wire-gate-picker">
				@foreach ( var category in WireGateComponent.GetGates() )
				{
					<div class="wire-gate-category">
						<div class="wire-gate-category-title">@category.Key</div>
						<div class="wire-gate-category-buttons">
							@foreach ( var gateName in category.Value )
							{
								var selected = gateTool.GateType == gateName;
								<button class="@(selected ? "active" : "")" @onclick="@(() => SelectGate( gateTool, gateName ))">@gateName</button>
							}
						</div>
					</div>
				}
			</div>
		}
	</div>
</root>

<style>
	.wire-gate-picker {
		flex-direction: column;
		width: 100%;
		flex-shrink: 0;
		margin-top: 12px;
		padding-top: 8px;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		gap: 10px;

		.wire-gate-category {
			flex-direction: column;
			width: 100%;
			flex-shrink: 0;
			gap: 4px;

			.wire-gate-category-title {
				width: 100%;
				flex-shrink: 0;
				font-size: 12px;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				opacity: 0.55;
				white-space: nowrap;
				padding: 2px 2px 0;
			}

			.wire-gate-category-buttons {
				flex-direction: row;
				flex-wrap: wrap;
				width: 100%;
				gap: 4px;
			}
		}

		button {
			padding: 6px 10px;
			background-color: rgba(0, 0, 0, 0.35);
			border-radius: 4px;
			font-size: 12px;
			cursor: pointer;
			pointer-events: all;
			white-space: nowrap;
			flex-shrink: 0;

			&:hover {
				background-color: rgba(255, 255, 255, 0.12);
			}

			&.active {
				background-color: rgba(70, 140, 255, 0.45);
			}
		}
	}
</style>

@code
{
	ToolMode CurrentMode => Player.FindLocalPlayer()?.GetWeapon<Toolgun>()?.GetCurrentMode();

	protected override int BuildHash() => HashCode.Combine(
		CurrentMode,
		(CurrentMode as WireGateTool)?.GateType,
		(CurrentMode as WireSpawnToolMode)?.SpawnModel );

	static IEnumerable<TypeDescription> GetWireTools()
	{
		return Game.TypeLibrary.GetTypes<ToolMode>()
			.Where( type => !type.IsAbstract && IsWireGroup( type.Group ) )
			.OrderBy( type => type.Title );
	}

	internal static bool IsWireGroup( string group )
	{
		if ( string.IsNullOrWhiteSpace( group ) ) return false;

		return group.Equals( "#tool.group.wire", StringComparison.OrdinalIgnoreCase )
			|| group.Equals( "Wire", StringComparison.OrdinalIgnoreCase )
			|| group.EndsWith( ".wire", StringComparison.OrdinalIgnoreCase );
	}

	void SwitchMode( TypeDescription t )
	{
		var localPlayer = Player.FindLocalPlayer();
		if ( localPlayer == null ) return;

		var inventory = localPlayer.GetComponent<PlayerInventory>();
		if ( !inventory.IsValid() ) return;

		inventory.SetToolMode( t.ClassName );
	}

	void SelectGate( WireGateTool tool, string gateName )
	{
		tool.SetGateType( gateName );
		StateHasChanged();
	}

	protected override void OnVisibilityChanged()
	{
		if ( !IsVisible )
		{
			GetCurrentMode()?.SaveCookies();
		}
	}

	ToolMode GetCurrentMode()
	{
		var localPlayer = Player.FindLocalPlayer();
		var toolgun = localPlayer?.GetWeapon<Toolgun>();
		var mode = toolgun?.GetCurrentMode();
		if ( mode is null || !IsWireGroup( mode.TypeDescription?.Group ) )
			return null;

		return mode;
	}

	static bool FilterProperties( SerializedProperty o )
	{
		if ( o is null || o.PropertyType is null ) return false;
		if ( o.PropertyType.IsAssignableTo( typeof( Delegate ) ) ) return false;

		if ( o.Name == nameof( WireGateTool.GateType ) ) return false;

		if ( o.IsMethod ) return true;
		if ( !o.HasAttribute<PropertyAttribute>() ) return false;

		return true;
	}
}
