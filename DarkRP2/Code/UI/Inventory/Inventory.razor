@using Sandbox;
@using Sandbox.UI;
@namespace Sandbox
@inherits PanelComponent
@implements Global.IPlayerEvents

@if ( Player.IsValid() && Player.WantsHideHud )
    return;

@if ( !inventory.IsValid() )
    return;

<root>
	@* Pocket + hotbar share one column so they keep identical width; presets sits beside the stack. *@
	<div class="hotbar-row">
		<div class="slot-stack">
			@if ( inspectOpen && pocket.IsValid() )
			{
				<div class="pocket">
					<div class="corner tl"><div class="arm-h"></div><div class="arm-v"></div></div>
					<div class="corner tr"><div class="arm-h"></div><div class="arm-v"></div></div>
					<div class="corner bl"><div class="arm-h"></div><div class="arm-v"></div></div>
					<div class="corner br"><div class="arm-h"></div><div class="arm-v"></div></div>
					<div class="pocket-rows">
						@for ( int row = 0; row < 2; row++ )
						{
							<div class="pocket-row">
								@for ( int col = 0; col < 9; col++ )
								{
									<PocketSlot Index=@(row * 9 + col) Pocket=@pocket></PocketSlot>
								}
							</div>
						}
					</div>
				</div>
			}

			<div class="hotbar">
				<div class="corner tl"><div class="arm-h"></div><div class="arm-v"></div></div>
				<div class="corner tr"><div class="arm-h"></div><div class="arm-v"></div></div>
				<div class="corner bl"><div class="arm-h"></div><div class="arm-v"></div></div>
				<div class="corner br"><div class="arm-h"></div><div class="arm-v"></div></div>
				@for ( int i = 0; i < inventory.MaxSlots; i++ )
				{
					<InventorySlot Index=@i Inventory=@inventory Active=@(activeSlot == i)></InventorySlot>
				}
			</div>
		</div>
		<HotbarPresetsButton Inventory=@inventory></HotbarPresetsButton>
	</div>
</root>

@code
{
    [Property, Group("Sound")] public SoundEvent SwitchSound { get; set; }

    Player Player => Player.FindLocalPlayer();

    PlayerInventory inventory;
    PlayerPocket pocket;
    int activeSlot = -1;
    bool inspectOpen;
    BaseCarryable prev;

    protected override int BuildHash()
    {
        var pocketHash = 0;
        if ( pocket.IsValid() )
        {
            foreach ( var item in pocket.Items )
                pocketHash = HashCode.Combine( pocketHash, item?.GameObject?.Id, item?.Slot, item?.GetDisplayName() );

            if ( pocket.SlotObjectIds is not null )
            {
                foreach ( var pair in pocket.SlotObjectIds.ToList() )
                    pocketHash = HashCode.Combine( pocketHash, pair.Key, pair.Value );
            }
        }

        var weaponHash = 0;
        if ( inventory.IsValid() )
        {
            foreach ( var weapon in inventory.Weapons )
                weaponHash = HashCode.Combine( weaponHash, weapon, weapon?.InventorySlot );
        }

        return HashCode.Combine( inventory, pocket, activeSlot, inspectOpen, Player?.WantsHideHud, pocketHash, weaponHash );
    }

    void Global.IPlayerEvents.OnPlayerPickup(PlayerPickupEvent e)
    {
        StateHasChanged();
    }

    bool IsSpawnMenuOpen()
    {
	    var host = Game.ActiveScene.Get<SpawnMenuHost>();
	    return host?.Panel?.HasClass("open") ?? false;
    }

    bool IsInspectMenuOpen()
    {
	    if ( !IsSpawnMenuOpen() )
		    return false;

	    return SpawnMenuHost.GetActiveMode() is ContextMenuHost;
    }

    protected override void OnUpdate()
    {
		inventory = Player?.GetComponent<PlayerInventory>();
        pocket = Player?.GetComponent<PlayerPocket>();
        activeSlot = inventory?.ActiveWeapon?.InventorySlot ?? -1;

        var spawnMenuOpen = IsSpawnMenuOpen();
        inspectOpen = IsInspectMenuOpen();
        Panel.SetClass( "spawnmenu-open", spawnMenuOpen );
        Panel.SetClass( "inspect-open", inspectOpen );

        // Style.Transform overrides stylesheet transforms, so bake spawnmenu dip in here.
        HudSway.Apply( Panel, extraOffset: spawnMenuOpen ? new Vector2( 0f, 24f ) : Vector2.Zero );
    }

    public void HandleInput()
    {
        if (inventory is null)
            return;

        MoveSlot( WireToolHud.SuppressScrollWheel ? 0 : -(int)Input.MouseWheel.y );

        if ( (Input.Pressed( "invprev" ) || Input.Pressed( "PreviousWeapon" )) && prev.IsValid() )
        {
            var weapon = prev;
            prev = inventory.ActiveWeapon;
            inventory.SwitchWeapon( weapon );
        }

        if (Input.Pressed("SlotNext")) MoveSlot(1);
        if (Input.Pressed("SlotPrev")) MoveSlot(-1);

        if (Input.Pressed("Slot1")) SelectSlot(0);
        if (Input.Pressed("Slot2")) SelectSlot(1);
        if (Input.Pressed("Slot3")) SelectSlot(2);
        if (Input.Pressed("Slot4")) SelectSlot(3);
        if (Input.Pressed("Slot5")) SelectSlot(4);
        if (Input.Pressed("Slot6")) SelectSlot(5);
        if (Input.Pressed("Slot7")) SelectSlot(6);
        if (Input.Pressed("Slot8")) SelectSlot(7);
        if (Input.Pressed("Slot9")) SelectSlot(8);
    }

    /// <summary>
    /// Pressing a number key directly switches to that slot's weapon.
    /// If the slot is empty or already active, holsters the current weapon.
    /// </summary>
    public void SelectSlot( int slot )
    {
        var weapon = inventory.GetSlot( slot );

        if ( weapon.IsValid() && !weapon.CanSwitch() )
            return;

        prev = inventory.ActiveWeapon;
        inventory.SwitchWeapon( weapon, allowHolster: true );

        Sound.Play( SwitchSound );
    }

    public void MoveSlot( int delta )
    {
        if ( delta == 0 )
            return;

        var weapons = inventory.Weapons.Where( x => x.CanSwitch() ).ToList();

        if ( weapons.Count == 0 )
            return;

        // Find current position in the ordered weapon list
        BaseCarryable current = inventory.ActiveWeapon ?? weapons.FirstOrDefault();

        int currentIndex = weapons.IndexOf( current );
        currentIndex += delta;
        currentIndex %= weapons.Count;
        if ( currentIndex < 0 )
            currentIndex = weapons.Count + currentIndex;

        var target = weapons[currentIndex];

        prev = inventory.ActiveWeapon;
        inventory.SwitchWeapon( target );

        Sound.Play( SwitchSound );
    }
}
