// HL2 props_lab keypad granted skin

Layer0
{
	shader "shaders/complex.shader"

	F_METALNESS_TEXTURE 1
	F_SELF_ILLUM 1
	F_SPECULAR 1

	g_flAmbientOcclusionDirectDiffuse "0.000"
	g_flAmbientOcclusionDirectSpecular "0.000"

	g_flModelTintAmount "1.000"
	g_vColorTint "[1.000000 1.000000 1.000000 0.000000]"
	TextureColor "materials/models/props_lab/keypad_granted_color.png"

	g_flFadeExponent "1.000"
	g_bFogEnabled "1"

	TextureMetalness "materials/models/props_lab/keypad_granted_metalness.png"
	TextureNormal "materials/models/props_lab/keypad_granted_normal.png"

	g_flRoughnessScaleFactor "1.000"
	TextureRoughness "materials/models/props_lab/keypad_granted_roughness.png"

	g_flSelfIllumAlbedoFactor "1.000"
	g_flSelfIllumBrightness "1.500"
	g_flSelfIllumScale "1.000"
	g_vSelfIllumTint "[1.000000 1.000000 1.000000 0.000000]"
	TextureSelfIllumMask "materials/models/props_lab/keypad_granted_selfillum.png"

	g_vTexCoordOffset "[0.000 0.000]"
	g_vTexCoordScale "[1.000 1.000]"
	g_vTexCoordScrollSpeed "[0.000 0.000]"
}
